  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6E7391", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.other", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#E8833A" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "#8A8FAD" } },
    { "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#E8833A" } },
    { "scope": ["string", "punctuation.definition.string", "string.template"], "settings": { "foreground": "#8FC9A3" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#7FCFD4" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#E86A92" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"], "settings": { "foreground": "#F2C14E" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "storage.type.class"], "settings": { "foreground": "#7FA7E8" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#D9D4C7" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#E7C3A1" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.property-name"], "settings": { "foreground": "#C9CCE0" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#E8833A" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#F2C14E" } },
    { "scope": ["entity.name.decorator", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#E86A92" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "#7FA7E8" } },
    { "scope": ["support.type.property-name.json", "support.type.property-name"], "settings": { "foreground": "#F2C14E" } },
    { "scope": ["markup.heading", "markup.heading entity.name"], "settings": { "foreground": "#F2C14E", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#E8833A", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#E86A92", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#8FC9A3" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#7FA7E8" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#A7AAC2", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#8FC9A3" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#E86A92" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#7FA7E8" } },
    { "scope": ["invalid"], "settings": { "foreground": "#E86A92", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "function": "#F2C14E",
    "method": "#F2C14E",
    "class": "#7FA7E8",
    "type": "#7FA7E8",
    "interface": "#7FA7E8",
    "enum": "#7FA7E8",
    "namespace": "#7FA7E8",
    "parameter": "#E7C3A1",
    "property": "#C9CCE0",
    "variable": "#D9D4C7",
    "variable.readonly": "#E86A92",
    "enumMember": "#E86A92",
    "decorator": "#E86A92",
    "keyword": "#E8833A",
    "string": "#8FC9A3",
    "number": "#E86A92",
    "selfParameter": "#E8833A"
  }
}
